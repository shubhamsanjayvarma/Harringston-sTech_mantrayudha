# ==============================================================================
# NovaMart Hybrid AI Customer Support Agent - Environment Configuration
# ==============================================================================

# Google Gemini API Credentials
# Get your API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here

# Model Selection (Recommended: gemini-3.8-flash for sub-second responses)
MODEL_NAME=gemini-3.8-flash

# Database Configuration
SQLITE_DB_PATH=backend/novamart.db

# Server Configuration
FASTAPI_PORT=8001
FASTAPI_HOST=127.0.0.1

# Offline / Hybrid Mode Flags
# If true and GEMINI_API_KEY is missing, gracefully falls back to deterministic rule engine
ENABLE_LIVE_MODEL=true
